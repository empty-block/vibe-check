{
  "name": "vibe-check",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun run --watch src/server/index.ts",
    "dev:client": "bun vite",
    "build": "bun run build:client && bun run build:server",
    "build:client": "bun vite build",
    "build:server": "bun build src/server/index.ts --outdir dist/server --target bun",
    "preview": "bun vite preview",
    "start": "bun run dist/server/index.js"
  },
  "devDependencies": {
    "@rollup/rollup-darwin-x64": "^4.46.1",
    "@types/bun": "latest",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "vite": "^7.0.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@farcaster/miniapp-sdk": "^0.1.7",
    "@farcaster/quick-auth": "^0.0.7",
    "@hono/node-server": "^1.17.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "emoji-picker-react": "^4.13.2",
    "hono": "^4.8.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
